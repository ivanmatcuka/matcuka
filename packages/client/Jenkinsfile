pipeline {
  agent any
  tools {
    nodejs '22.13'
  }
  environment {
    DEPLOY_USER = credentials('deploy-user')
    DEPLOY_HOST = credentials('deploy-host')
    DOCKERHUB_PASSWORD = credentials('dockerhub-password')
    DOCKERHUB_USER = credentials('dockerhub-username')
  }
  stages {
    stage('Lint') {
      dir('packages/client') {
        steps {
          echo 'Linting....'
          sh 'npm i'
          sh 'npm run lint'
        }
      }
    }
    stage('Set Up Docker') {
      dir('packages/client') {
        steps {
          sh 'chmod +x /usr/local/bin/docker-compose'
          sh ''
          'docker login -u ${DOCKERHUB_USER} -p ${DOCKERHUB_PASSWORD}'
          ''
        }
      }
    }
    stage('Build for Development') {
      dir('packages/client') {
        steps {
          echo 'Building....'
          sh 'docker-compose -f docker-compose.dev.yml build'
        }
      }
    }
    stage('Push Development Version') {
      dir('packages/client') {
        steps {
          echo 'Pushing....'
          sh 'docker-compose -f docker-compose.dev.yml push'
        }
      }
    }
    stage('Deploy to Development') {
      dir('packages/client') {
        steps {
          echo 'Deploying....'
          withCredentials([file(credentialsId: 'env-development', variable: 'secretFile')]) {
            sh 'touch .env'
            sh 'cat $secretFile > .env'
            sh ''
            'DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker-compose -f docker-compose.dev.yml down'
            ''
            sh ''
            'DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker-compose -f docker-compose.dev.yml up -d'
            ''
          }
        }
      }
    }
  }
}