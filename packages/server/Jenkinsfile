pipeline {
    agent any

    tools {
        nodejs '24'
    }

    environment {
        DEPLOY_USER = credentials('deploy-user')
        DEPLOY_HOST = credentials('deploy-host')

        DOCKERHUB_PASSWORD = credentials('dockerhub-password')
        DOCKERHUB_USER = credentials('dockerhub-username')
    }

    stages {
        stage('Set Up Docker') {
            steps {
                sh '''docker login -u ${DOCKERHUB_USER} -p ${DOCKERHUB_PASSWORD}'''
            }
        }

        stage('Set Up Development .env') {
            when {
                branch 'development'
            }

            steps {
                dir('packages/server') {
                    withCredentials([file(credentialsId: 'env-development', variable: 'secretFile')]) {
                        sh 'rm -f .env'
                        sh 'touch .env'
                        sh 'cat $secretFile > .env'
                    }
                }
            }
        }

        stage('Build for Development') {
            when {
                branch 'development'
            }

            steps {
                dir('packages/server') {
                    echo 'Building....'
                    sh 'docker compose -f docker-compose.development.yml build'
                }
            }
        }

        stage('Push Development Version') {
            when {
                branch 'development'
            }

            steps {
                dir('packages/server') {
                    echo 'Pushing....'
                    sh 'docker compose -f docker-compose.development.yml push'
                }
            }
        }

        stage('Deploy to Development') {
            when {
                branch 'development'
            }

            steps {
                dir('packages/server') {
                    echo 'Deploying....'
                    sh '''DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker compose -f docker-compose.development.yml down --rmi all'''
                    sh '''DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker compose -f docker-compose.development.yml up -d'''
                }
            }
        }

        stage('Set Up Production .env') {
            when {
                buildingTag()
            }

            steps {
                dir('packages/server') {
                    withCredentials([file(credentialsId: 'env-production', variable: 'secretFile')]) {
                        sh 'rm -f .env'
                        sh 'touch .env'
                        sh 'cat $secretFile > .env'
                    }
                }
            }
        }

        stage('Build for Production') {
            when {
                buildingTag()
            }

            steps {
                dir('packages/server') {
                    echo 'Building....'
                    sh 'docker compose -f docker-compose.yml build'
                }
            }
        }

        stage('Push Production Version') {
            when {
                buildingTag()
            }

            steps {
                dir('packages/server') {
                    echo 'Pushing....'
                    sh 'docker compose -f docker-compose.yml push'
                }
            }
        }

        stage('Deploy to Production') {
            when {
                buildingTag()
            }

            steps {
                dir('packages/server') {
                    echo 'Deploying....'
                    sh '''DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker compose -f docker-compose.yml down --rmi all'''
                    sh '''DOCKER_HOST=ssh://${DEPLOY_USER}@${DEPLOY_HOST} docker compose -f docker-compose.yml up -d'''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
