{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Jobs",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "freelance",
        "full-time",
        "half-time"
      ]
    },
    "from": {
      "type": "date"
    },
    "to": {
      "type": "date"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill"
    }
  }
}
